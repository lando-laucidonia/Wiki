---
layout: null
---
[
{% assign first = true %}
{% assign groups = "geografia,historia,provincias,cidades,instituicoes,personagens,religiao,cultura" | split: "," %}
{% for group in groups %}
  {% assign docs = site[group] %}
  {% for doc in docs %}{% unless first %},{% endunless %}{"title":{{ doc.title | jsonify }},"url":{{ doc.url | relative_url | jsonify }},"description":{{ doc.description | default: '' | strip_html | normalize_whitespace | jsonify }},"text":{{ doc.content | strip_html | normalize_whitespace | truncate: 1200 | jsonify }}}{% assign first = false %}{% endfor %}
{% endfor %}
]
