<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for p in site.pages %}{% if p.url and p.url != '/search.json' %}<url><loc>{{ p.url | absolute_url }}</loc></url>{% endif %}{% endfor %}
{% assign groups = "geografia,historia,provincias,cidades,instituicoes,personagens,religiao,cultura" | split: "," %}
{% for group in groups %}{% for doc in site[group] %}<url><loc>{{ doc.url | absolute_url }}</loc></url>{% endfor %}{% endfor %}
</urlset>
